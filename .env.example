# Frontend build. Both are public by design: the anon key only ever sees what row level
# security allows. Leave blank and the site builds browse-only (map works, no accounts).
VITE_SUPABASE_URL=https://<proje-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Edge function secrets. Set with `supabase secrets set ...`, never in a VITE_ variable and
# never in git. SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# Supabase automatically; the rest are yours to provide.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLIENT_URL=https://haydarsahin0.github.io/mahalle/
CLIENT_ORIGIN=https://haydarsahin0.github.io

# Only for `npm run db:test`, which runs the money rules against a scratch database.
DATABASE_URL=
